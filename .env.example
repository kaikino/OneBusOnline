# OneBusAway API key and regional host, e.g. https://api.pugetsound.onebusaway.org
ONEBUSAWAY_API_KEY=
OBA_BASE_URL=

# Redis connection string. Without it nothing is cached.
REDIS_URL=

PORT=3001

# Comma-separated origins allowed to call the API. Only needed when the web app is served from another domain.
CORS_ORIGIN=

# Required for live OBA data (get a key from your regional OBA provider).
ONEBUSAWAY_API_KEY=

# Regional multi-agency OBA API host (no trailing path). Falls back to ONEBUSAWAY_SDK_BASE_URL.
# Puget Sound (Metro + Sound Transit + others): https://api.pugetsound.onebusaway.org
OBA_BASE_URL=

# --- Local dev only (ignored on Vercel) ---
PORT=3001
# Comma-separated allowed web origins in production (not needed on Vercel — same origin).
CORS_ORIGIN=http://localhost:5173

# Redis URL (required for serverless; recommended for all deployments).
# e.g. redis://localhost:6379 or rediss://default:xxx@host:6380
REDIS_URL=

# Optional cache tuning (seconds).
CACHE_STOPS_TTL_SEC=600
CACHE_ARRIVALS_TTL_SEC=25
# Optional: OBA arrivals time window when the client omits query params (defaults 120 / 15).
# ARRIVALS_MINUTES_AFTER_DEFAULT=180
# ARRIVALS_MINUTES_BEFORE_DEFAULT=15

# Optional: max stops returned by GET /api/v1/stops/snapshot (merged Redis entries).
# STOPS_SNAPSHOT_MAX_STOPS=100000

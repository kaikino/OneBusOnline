# OneBusAway API key and regional host, e.g. https://api.pugetsound.onebusaway.org
ONEBUSAWAY_API_KEY=
OBA_BASE_URL=

# Redis connection string. Without it nothing is cached.
REDIS_URL=

# Local development only.
PORT=3001

# Comma-separated origins allowed to call the API. Only needed when the web app is served from another domain.
CORS_ORIGIN=

# Web Push keys for bus notifications, from `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# QStash delivers each notification at its time. Without a token, local development uses timers.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public origin QStash calls back. Defaults to the Vercel production domain.
APP_URL=

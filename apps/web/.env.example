# On Vercel, leave VITE_API_BASE_URL empty — the API is on the same origin via /api/*.
# For local dev, also leave empty (Vite proxies /api to the BFF on port 3001).
# Only set this if the API lives on a separate domain.
VITE_API_BASE_URL=

# Optional: how far ahead / behind to request arrivals (default 120 / 15 minutes).
# VITE_ARRIVALS_MINUTES_AFTER=180
# VITE_ARRIVALS_MINUTES_BEFORE=15
# Minutes added per "Show arrivals further ahead" tap (default 120, max 360).
# VITE_ARRIVALS_EXTEND_STEP_MIN=120

# In production, set to your deployed API origin, e.g. https://api.example.com
# Leave empty for local dev (Vite proxies /api to the BFF on port 3001).
VITE_API_BASE_URL=

# Optional: how far ahead / behind to request arrivals (default 120 / 15 minutes). Max 720 / 120.
# VITE_ARRIVALS_MINUTES_AFTER=180
# VITE_ARRIVALS_MINUTES_BEFORE=15
# Minutes added per “Show arrivals further ahead” tap (default 120, max 360).
# VITE_ARRIVALS_EXTEND_STEP_MIN=120

{
  "buildCommand": "npm run build -w @onebus/shared && npm run build -w @onebus/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "nodeVersion": "20.x",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
